# Server Configuration
HOST=0.0.0.0
PORT=3014

# Database & Storage
DATA_DIR=./data
SQLITE_DB_PATH=./data/tluagent.db

# Logging
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5

# JWT Authentication
# Leave both values empty to auto-generate secure random keys persisted in DATA_DIR (data/.jwt_secret, data/.jwt_refresh_secret).
# If provided, each value MUST be at least 32 characters long; the server refuses to start otherwise.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Initial Setup Protection (optional)
# When set, POST /api/setup additionally requires the X-Setup-Token header with this exact value.
SETUP_TOKEN=

# Chat Abuse Protection
CHAT_GUEST_DAILY_QUOTA=20
CHAT_USER_DAILY_QUOTA=200
CHAT_MAX_STREAMS=50
CHAT_MAX_STREAMS_PER_CLIENT=2

# Reverse Proxy
# Number of trusted reverse-proxy hops in front of the server (0 = trust only RemoteAddr).
TRUSTED_PROXY_HOPS=0

# Cookies & TLS
# Force the Secure flag on auth cookies and enable HSTS. Defaults to true when APP_ENV=production.
COOKIE_SECURE=
APP_ENV=development

# CORS
# Comma-separated allowlist of origins allowed to call the API. Empty = no cross-origin access (same-origin SPA needs none).
CORS_ALLOWED_ORIGINS=
