# Host port published by docker compose (container always listens on 3434)
APP_PORT=3013

# Server Configuration
HOST=0.0.0.0
# Local dev listen port; docker compose always runs the container itself on 3434
PORT=3014
APP_ENV=development

# Storage Directory (Database, keys, and session artifacts)
DATA_DIR=./data

# Security & Initial Setup (Optional)
CORS_ALLOWED_ORIGINS=
SETUP_TOKEN=

CMS_API_BASE_URL=
CMS_SITE_URL=
CMS_LOCALE=vi

# Tuition portal base URL used by the tuition lookup tool (e.g. https://<portal-host>/pay/<tenant>)
TUITION_PORTAL_URL=

# Embedding (Optional): set to 0 to skip the automatic ONNX runtime/model download on first boot
EMBEDDING_AUTO_DOWNLOAD=1
